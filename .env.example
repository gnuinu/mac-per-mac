# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 커밋되지 않습니다.
#
# 전부 선택 사항입니다. 없으면 해당 조회 단계만 조용히 건너뛰고
# 로컬 카탈로그만으로 동작합니다.

# ── 서버 함수 (api/, functions/) ──────────────────────────────────────
# 네이버 쇼핑 검색 API. 발급 절차는 README의 "네이버 쇼핑 API 설정" 참고.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude API. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 추정에 쓸 모델. 비워두면 claude-sonnet-4-6.
# 더 정확한 추정이 필요하면 claude-sonnet-5.
CLAUDE_MODEL=

# 교차 출처에서 함수를 부를 때만 설정합니다. 예: 정적 호스팅 + 외부 함수 조합.
# 같은 출처 배포(Cloudflare Pages, Vercel)에서는 비워두세요 — 비워두면
# CORS 헤더를 아예 안 붙여서 남이 내 API 할당량을 태우는 일을 막습니다.
# ALLOWED_ORIGIN=https://gnuinu.github.io

# ── 프론트엔드 (빌드 시점에 박힙니다) ────────────────────────────────
# 조회 API가 있는 곳.
#   미설정        같은 출처 (`/api/…`). Cloudflare Pages·Vercel.
#   none          원격 조회를 끕니다. GitHub Pages 같은 정적 단독 배포.
#   https://…     다른 출처.
# VITE_API_BASE_URL=

# 서브패스 배포용. GitHub Pages는 /<repo>/ 아래에 서빙되므로 필요합니다.
# Cloudflare Pages·Vercel은 루트라 비워두세요.
# BASE_PATH=/mac-per-mac/
