# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 커밋되지 않습니다.
#
# 두 그룹 모두 선택 사항입니다. 없으면 해당 조회 단계만 조용히 건너뛰고
# 로컬 카탈로그만으로 동작합니다.

# ── 네이버 쇼핑 검색 API (조회 2단계) ─────────────────────────────────
# 발급 절차는 README.md의 "네이버 쇼핑 API 설정"을 참고하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Claude API (조회 3단계, 추정 폴백) ────────────────────────────────
# https://console.anthropic.com/settings/keys 에서 발급합니다.
ANTHROPIC_API_KEY=

# 추정에 쓸 모델. 비워두면 claude-sonnet-4-6을 씁니다.
# 더 정확한 추정이 필요하면 claude-sonnet-5 를 넣으세요.
CLAUDE_MODEL=
